<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kori.ViewModels"
             xmlns:root="clr-namespace:Kori"
             xmlns:ic="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Kori.Views.ConnectionErrorWindowView"
             x:DataType="vm:ConnectionErrorWindowViewModel"
             x:CompileBindings="False">

    <Grid Background="#F7F7F8">

        <StackPanel Orientation="Vertical"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="30"
                    MaxWidth="480">

            <Border Background="White"
                    CornerRadius="12"
                    Padding="40"
                    BorderBrush="#E5E5E7"
                    BorderThickness="1"
                    BoxShadow="0 2 8 0 #14000000">

                <StackPanel Orientation="Vertical" Spacing="20" HorizontalAlignment="Center">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="32"
                            Background="{DynamicResource Brush.Surface}"
                            HorizontalAlignment="Center">
                        <ic:MaterialIcon Kind="CloudOffOutline"
                                         IconSize="32"
                                         Foreground="{DynamicResource Brush.Text.Secondary}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{root:Localize ConnectionError.Title}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="{root:Localize ConnectionError.Subtitle}"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Button Command="{Binding ReloadCommand}"
                            Classes="PrimaryRounded"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,12"
                            CornerRadius="6"
                            FontWeight="SemiBold"
                            FontSize="14"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <ic:MaterialIcon Kind="Refresh" IconSize="16"/>
                            <TextBlock Text="{root:Localize ConnectionError.Reload}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Border>

        </StackPanel>
    </Grid>

</UserControl>
