<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kori.ViewModels"
             xmlns:root="clr-namespace:Kori"
             xmlns:ic="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:Kori.Converters"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Kori.Views.ConnectorsWindowView"
             x:DataType="vm:ConnectorsWindowViewModel"
             x:CompileBindings="False">

    <Grid Background="{DynamicResource Brush.Neutral}"
          RowDefinitions="Auto, *">
        
        <StackPanel Grid.Row="0" Margin="32" Spacing="24">
            <TextBlock  Text="{root:Localize Connectors.Title}"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Text.Primary}"/>
        
            <Border Background="White"
                    CornerRadius="10"
                    BorderBrush="#E2E4E9"
                    BorderThickness="1"
                    Padding="16,13"
                    BoxShadow="0 1 3 0 #0A000000">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <ic:MaterialIcon Grid.Column="0"
                                     Kind="Magnify"
                                     IconSize="18"
                                     Foreground="{DynamicResource Brush.Text.Secondary}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0"/>

                    <TextBox Grid.Column="1"
                             Classes="SearchBar"
                             Text="{Binding SearchText}"
                             PlaceholderText="{root:Localize Connectors.SearchPlaceholder}"
                             FontSize="15"
                             PlaceholderForeground="{DynamicResource Brush.Text.Secondary}"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding HasSearchText}"
                            Classes="TextButton"
                            Background="Transparent"
                            Padding="4"
                            Cursor="Hand">
                        <ic:MaterialIcon Kind="CloseCircle"
                                         IconSize="16"
                                         Foreground="{DynamicResource Brush.Text.Secondary}"/>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="32" Spacing="24">

                <!-- Empty state -->
                <StackPanel Spacing="12"
                            HorizontalAlignment="Center"
                            Margin="0,60,0,0"
                            IsVisible="{Binding ConnectorGroup.Count, Converter={x:Static conv:IsZeroConverter.Instance}}">
                    <ic:MaterialIcon Kind="PuzzleOutline"
                                     IconSize="56"
                                     Foreground="{DynamicResource Brush.Text.Secondary}"
                                     HorizontalAlignment="Center"/>
                    <TextBlock Text="{root:Localize Connectors.Empty.Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{root:Localize Connectors.Empty.Subtitle}"
                               FontSize="13"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Provider cards -->
                <ItemsControl ItemsSource="{Binding ConnectorGroup}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Surface}"
                                    CornerRadius="12"
                                    Padding="20">
                                <StackPanel Spacing="16">

                                    <!-- Provider header -->
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border CornerRadius="8"
                                                Width="40" Height="40"
                                                Padding="4">
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding Icon}"
                                                   Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Text="{Binding Provider}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{DynamicResource Brush.Neutral}"/>

                                    <!-- Entries -->
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">

                                                    <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
                                                        <Ellipse Width="8" Height="8"
                                                                 
                                                                 VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Content="{root:Localize Connectors.Connect}"
                                                            IsVisible="{Binding !Active}"
                                                            Classes="PrimaryRounded"
                                                            CornerRadius="6"
                                                            Padding="14,6"
                                                            Command="{Binding $parent[UserControl].DataContext.ConnectCommand}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Grid.Column="1"
                                                            Content="{root:Localize Connectors.Disconnect}"
                                                            IsVisible="{Binding Active}"
                                                            BorderThickness="1"
                                                            Classes="SecondaryRounded"
                                                            CornerRadius="6"
                                                            Padding="14,6"
                                                            Command="{Binding $parent[UserControl].DataContext.DisconnectCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>