<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Default TextBox Style -->
    <Style Selector="TextBox.Default">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="PlaceholderForeground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Padding" Value="10"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}"/>
    </Style>
    
    <Style Selector="TextBox.Default /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="Margin" Value="0 0 8 0"/>
    </Style>
    
    <Style Selector="TextBox.Default:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#F0F1F1"/>
    </Style>
    
    <Style Selector="TextBox.Default:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#F0F1F1"/>
    </Style>
    
    <!-- End Default TextBox Style -->
    
    <!-- SearchBar TextBox Style -->
    <Style Selector="TextBox.SearchBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Primary}"/>
    </Style>
    
    <Style Selector="TextBox.SearchBar /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="Margin" Value="0 0 8 0"/>
    </Style>
    
    <Style Selector="TextBox.SearchBar:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    
    <Style Selector="TextBox.SearchBar:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <!-- End SearchBar TextBox Style -->
    
</Styles>
